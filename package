#!/bin/sh
# package -- build the ONE unzip-and-run offline folder (a single .zip: the repo + a fully
# populated vendor/ of engines, no install). Run this on a CONNECTED build machine; carry the
# resulting dist/lykos-offline-*.zip to the offline laptop, unzip, and ./start.
# Prerequisite: an offline toolchain bundle in dist/ (build it with: make toolchain-bundle).
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec bash "$here/packaging/make-runnable.sh" "$@"
