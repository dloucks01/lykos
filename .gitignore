dist/
# Air-gap toolchain bundle + zipapp are build artifacts, never committed: they are
# large (GBs) and machine/distro-specific. Built on a connected machine and carried by
# sneakernet (docs 11, 23). Patterns below also catch a bundle built outside dist/ via --out.
*.tar.zst
*.tar.zst.sha256
lykos-toolchain-*
.mypy_cache/
.pytest_cache/
.cases/
.cases2/
.ruff_cache/
__pycache__/
*.pyc
*.pyz
# The air-gap toolchain vendor tree at the repo ROOT only. Anchored with a leading slash so it
# never swallows core/lykos/api/static/vendor/ -- the vendored Preact/htm ESM runtime the web
# UI loads, which IS source and must ship in the package (git archive skips ignored files, so an
# unanchored `vendor/` shipped a blank UI: the import map resolved to files that were not there).
/vendor/
eval-report.json
eval-history.jsonl
eval-dashboard.html
examples/re-corpus/bin/*
!examples/re-corpus/bin/manifest.tsv
examples/vuln-targets/bin/*
!examples/vuln-targets/bin/manifest.tsv
examples/vuln-targets/src/

# coverage (make coverage)
.coverage
.coverage.*
.coverage-shim/
htmlcov/
packaging/_vendor/

# Offline CVE data: the full OSV match-index mirror and the NVD reference pack are large data
# artifacts built by tools/build_cvedb.py and shipped WITH THE PACKAGE, not via git. The small
# curated subset (data/osv_cvedb.json) IS committed so the tool matches common packages without
# them. (See core/lykos/analyze/fingerprint/cvedb.py for discovery order.)
core/lykos/analyze/fingerprint/data/cvedb.sqlite
core/lykos/analyze/fingerprint/data/cve.sqlite
core/lykos/analyze/fingerprint/data/*.sqlite.building

# libFuzzer/AFL artifacts dropped in the cwd. The engine is always driven with an explicit
# -artifact_prefix into the case workdir (libfuzzer.py), but a hand-run of a built harness lands
# them here -- and one (crash-2ab19295...) was committed that way and sat in the tree unreferenced.
crash-*
oom-*
timeout-*
leak-*

# PoC bundles `lykos analyze` writes NEXT TO ITSELF. `--out` defaults to the cwd, so running the
# CLI from the repo root drops `<name>-L<n>-<sha>.tar.gz` into the tree -- six of them, from one
# run, while checking something else. Same lesson as the libFuzzer artifacts above: the engine is
# careful about where it puts things and a hand-run is not.
*-L0-*.tar.gz
*-L1-*.tar.gz
*-L2-*.tar.gz
*-L3-*.tar.gz
.cases-web/
.cases-web2/
